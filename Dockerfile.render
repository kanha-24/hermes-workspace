# Render deployment for a Hermes Agent Discord gateway.
# Render Web Services require an HTTP listener on the PORT environment variable.
FROM nousresearch/hermes-agent:latest

# Render uses PORT=10000 by default for Web Services.
# Hermes exposes its OpenAI-compatible API server on the same port so Render
# can detect the service as healthy while Discord continues through the gateway.
ENV API_SERVER_ENABLED=true
ENV API_SERVER_HOST=0.0.0.0
ENV API_SERVER_PORT=10000

EXPOSE 10000

# Run the Discord/messaging gateway in the foreground.
CMD ["gateway", "run"]
