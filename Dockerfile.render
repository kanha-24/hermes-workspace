# Render deployment for a Hermes Agent Discord gateway.
# The official Hermes image contains the gateway and its runtime.
FROM nousresearch/hermes-agent:latest

# Render web services need a process listening on PORT.
ENV API_SERVER_ENABLED=true
ENV API_SERVER_HOST=0.0.0.0
ENV API_SERVER_PORT=8642

# Run the Discord/messaging gateway in the foreground.
CMD ["gateway", "run"]
